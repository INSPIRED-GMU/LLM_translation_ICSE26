    "<h3 align=\"center\">\n",
    "  <a href=\"https://reactnative.dev/docs/getting-started\">Erste Schritte</a>\n",
    "  <span> · </span>\n",
    "  <a href=\"https://reactnative.dev/docs/tutorial\">Grundlagen lernen</a>\n",
